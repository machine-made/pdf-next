<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "pdf-next-app": the application binary,
     signed before the installers are built around it. Paste into SignPath
     (project pdf-next → Artifact configurations); this copy is the reference. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" default-value="0.0.0" />
  </parameters>
  <zip-file>
    <pe-file path="pdf-next.exe" product-name="pdf-next" product-version="${version}">
      <authenticode-sign description="pdf-next ${version}" description-url="https://github.com/machine-made/pdf-next" />
    </pe-file>
  </zip-file>
</artifact-configuration>
